# رابط قاعدة بيانات PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/invoices?schema=public"
# مفتاح Google Gemini لتشغيل المساعد الذكي (من https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=""
# (اختياري) نموذج Gemini المستخدم
GEMINI_MODEL="gemini-flash-latest"

# ---- بوت Telegram (اختياري) ----
# التوكن من @BotFather
TELEGRAM_BOT_TOKEN=""
# سر عشوائي طويل يحمي الـ webhook (مثلاً: openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=""
# معرّفات حسابات Telegram المسموح لها (أرسل /id للبوت لمعرفة معرّفك)، مفصولة بفواصل
TELEGRAM_ALLOWED_USER_IDS=""
# الرابط العام للنظام لبناء روابط الفواتير في الردود
APP_URL="https://invo.atmata.ly"

# ---- أداء المساعد الذكي (اختياري) ----
# نماذج بديلة تُجرّب بالترتيب عند انشغال النموذج الأساسي (503/429/مهلة)، مفصولة بفواصل
GEMINI_FALLBACK_MODELS="gemini-flash-lite-latest"
# نموذج تفريغ الصوت وقراءة الصور وPDF (الافتراضي = GEMINI_MODEL)؛ flash-lite أسرع وأرخص لهذه المهام
GEMINI_MEDIA_MODEL=""
# مهلة كل محاولة بالمللي ثانية: الوكيل، ثم الوسائط
GEMINI_TIMEOUT_MS="90000"
GEMINI_MEDIA_TIMEOUT_MS="45000"
# عدد أدوار المحادثة التي يتذكرها بوت Telegram
TELEGRAM_HISTORY_TURNS="8"
