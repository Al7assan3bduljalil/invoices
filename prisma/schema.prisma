// نظام الفواتير — مخطط قاعدة البيانات
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  DRAFT     // مسودة
  SENT      // مُرسلة
  PAID      // مدفوعة
  OVERDUE   // متأخرة
  CANCELLED // ملغاة
}

/// المستخدم / التاجر صاحب الحساب
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  companyName   String?
  companyAddress String?
  taxNumber     String?
  phone         String?
  currency      String    @default("USD")
  defaultTaxRate Decimal  @default(15) @db.Decimal(5, 2)
  invoicePrefix String    @default("INV")
  nextInvoiceNumber Int   @default(1)
  /// صورة الختم (base64 data URL)
  stampUrl      String?   @db.Text
  /// صورة التوقيع (base64 data URL)
  signatureUrl  String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  clients  Client[]
  products Product[]
  invoices Invoice[]
}

/// العميل
model Client {
  id        String   @id @default(cuid())
  userId    String
  name      String
  email     String?
  phone     String?
  address   String?
  taxNumber String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([userId])
  @@index([userId, name])
}

/// المنتج أو الخدمة
model Product {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  unit        String   @default("وحدة")
  price       Decimal  @db.Decimal(12, 2)
  taxRate     Decimal? @db.Decimal(5, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items InvoiceItem[]

  @@index([userId])
}

/// الفاتورة الرئيسية
model Invoice {
  id             String        @id @default(cuid())
  userId         String
  clientId       String
  number         String
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  currency       String        @default("USD")
  /// نسبة الضريبة المئوية المطبقة على المجموع بعد الخصم
  taxRate        Decimal       @default(0) @db.Decimal(5, 2)
  /// قيمة الخصم الثابتة
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @default(0) @db.Decimal(12, 2)
  notes          String?
  paidAt         DateTime?
  /// تاريخ الأرشفة — الفواتير المؤرشفة تظهر في صفحة الأرشيف فقط
  archivedAt     DateTime?
  createdByAI    Boolean       @default(false)
  /// رمز مشاركة عشوائي للرابط العام — غير قابل للتخمين
  shareToken     String        @unique @default(cuid())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  items  InvoiceItem[]

  @@unique([userId, number])
  @@index([userId, status])
  @@index([userId, archivedAt])
  @@index([clientId])
}

/// بند من بنود الفاتورة
model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  unit        String   @default("وحدة")
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  position    Int      @default(0)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}
